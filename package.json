{
  "name": "shelfstack",
  "version": "1.1.0-beta.29",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxi typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:load": "node --env-file-if-exists=.env scripts/load-test/runner.mjs",
    "db:seed": "node scripts/seed.mjs --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:seed:remote": "node scripts/seed.mjs --remote"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^1.0.1",
    "@supabase/supabase-js": "^2.112.2",
    "date-fns": "^4.4.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@e2e-dev/web": "^0.13.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.5",
    "@vue/test-utils": "^2.4.11",
    "ai": "^7.0.0",
    "e2e": "^0.18.0",
    "eslint": "^10.8.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
