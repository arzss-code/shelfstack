#!/bin/bash

# Protect master/main/develop and enforce branch naming conventions
echo -e "===\n>> Talenavi Pre-commit Hook:: Checking branch name / Mengecek nama branch..."
branchName=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || git branch --show-current)

# 1. Protect production and integration branches from direct commits
if [ "$branchName" == "master" ] || [ "$branchName" == "main" ]; then
  echo -e "\n🚫 [TALENAVI SOP ERROR] Commit directly to '$branchName' branch is not allowed!"
  echo -e "🚫 Commit langsung ke branch '$branchName' dilarang keras! Gunakan branch fitur/fix dan buat Pull Request.\n"
  exit 1
fi

if [ "$branchName" == "develop" ]; then
  echo -e "\n🚫 [TALENAVI SOP ERROR] Direct commit to 'develop' branch is not allowed!"
  echo -e "🚫 Tidak bisa commit langsung ke branch develop. Silakan buat branch kerja sendiri dan gunakan Pull Request.\n"
  exit 1
fi

# Skip checks for detached HEAD (e.g. CI or rebase)
if [ "$branchName" == "HEAD" ] || [ -z "$branchName" ]; then
  echo -e ">> Detached HEAD state detected, skipping branch name validation.\n==="
else
  # 2. Check for non-ASCII characters
  if [[ "$branchName" = *[![:ascii:]]* ]]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Branch name contains non-ASCII characters!"
    echo -e "🚫 Nama branch tidak boleh mengandung karakter non-ASCII.\n"
    exit 1
  fi

  # 3. Check for uppercase letters
  if [[ "$branchName" =~ [A-Z] ]]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Branch name contains uppercase letters!"
    echo -e "🚫 Nama branch wajib menggunakan huruf kecil semua (lowercase kebab-case).\n"
    exit 1
  fi

  # 4. Check for forbidden keywords (production / prod)
  if [[ "$branchName" =~ (^|[-/])(production|prod)([-/]|$) ]]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Forbidden keyword detected in branch name!"
    echo -e "🚫 Dilarang menggunakan kata 'production' atau 'prod' pada nama branch fitur/perbaikan.\n"
    exit 1
  fi

  # 5. Check allowed branch prefix convention
  ALLOWED_PREFIXES="^(feat|fix|hotfix|refactor|chore|docs|style|perf|test|ci)/"
  if [[ ! "$branchName" =~ $ALLOWED_PREFIXES ]]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Invalid branch prefix!"
    echo -e "Format Wajib: <type>/<domain-slug>"
    echo -e "Prefix yang diizinkan: feat/, fix/, hotfix/, refactor/, chore/, docs/, style/, perf/, test/, ci/"
    echo -e "Nama branch saat ini: '$branchName'\n"
    exit 1
  fi

  # 6. Check slug format (kebab-case)
  slug="${branchName#*/}"
  if [[ ! "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Invalid slug format in branch name!"
    echo -e "Slug branch wajib kebab-case (hanya huruf kecil, angka, dan tanda hubung tunggal)."
    echo -e "Contoh valid: fix/gallery-and-layout\n"
    exit 1
  fi

  # 7. Check slug word count (max 4 words according to SOP)
  wordCount=$(echo "$slug" | awk -F'-' '{print NF}')
  if [ "$wordCount" -gt 4 ]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Branch slug has too many words ($wordCount words > max 4 words)!"
    echo -e "SOP Talenavi membatasi panjang slug branch maksimal 2 sampai 4 kata."
    echo -e "Hindari nama panjang mirip kalimat. Contoh: 'fix/compact-gallery' bukan '$branchName'\n"
    exit 1
  fi

  # 8. Check total branch length (max 40 characters)
  maxBranchLen=40
  branchLen=${#branchName}
  if [ "$branchLen" -gt "$maxBranchLen" ]; then
    echo -e "\n🚫 [BRANCH NAMING ERROR] Branch name is too long ($branchLen chars > max $maxBranchLen chars)!"
    echo -e "SOP merekomendasikan panjang branch ideal antara 15 sampai 35 karakter (maksimal $maxBranchLen karakter)."
    echo -e "Nama branch saat ini: '$branchName' ($branchLen karakter)\n"
    exit 1
  fi

  echo -e ">> Branch name '$branchName' valid ($wordCount words, $branchLen chars)."
fi

echo -e ">> Finish checking branch name / Selesai mengecek nama branch.\n==="

# Run Linters and Formatters
pnpm exec lint-staged -r --max-arg-length 4000
