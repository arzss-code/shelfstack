#!/bin/bash
# Prevents direct push to protected branches

echo -e "===\n>> Talenavi Pre-push Hook: Checking branch name / Mengecek nama branch..."

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$1")
PROTECTED_BRANCHES="^(master|main|develop)$"

if [[ "$BRANCH" =~ $PROTECTED_BRANCHES ]]
then
  echo -e "\n🚫 Cannot push directly to remote $BRANCH branch, please create your own branch and use PR."
  echo -e "🚫 Tidak bisa push langsung ke remote branch $BRANCH, silakan buat branch kerja sendiri dan gunakan pull request.\n"
  exit 1
fi

echo -e ">> Finish checking branch name / Selesai mengecek nama branch.\n==="

exit 0
