# Application Environment (Staging / Production)
APP_ENV=Staging

# Supabase Configuration
NUXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key
NUXT_SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Feature Flags
ENABLE_NEW_PRODUCT_UI=false
NUXT_PUBLIC_ENABLE_MIDTRANS_SANDBOX=false

# Midtrans Sandbox Configuration
NUXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NUXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
MIDTRANS_SERVER_KEY=
MIDTRANS_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

