# Application Environment (Staging / Production)
APP_ENV=Staging

# Supabase Configuration
NUXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key
NUXT_SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Identity Services / One Tap OAuth (Optional: jika diisi, login Google menggunakan GIS ID token tanpa redirect ke supabase.co)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# MCP Supabase Devtools (local only, jangan commit nilai asli)
# Diambil dari subdomain URL: https://<PROJECT_REF>.supabase.co
SUPABASE_PROJECT_REF=mbcyttxkfppcdvwitrif
# Buat di https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxx_ganti_dengan_token_kamu

# Internal Microservices & Infrastructure (Pilot Services & Caching)
REDIS_URL=redis://localhost:6379
ORDER_SERVICE_URL=http://localhost:4000
INTERNAL_SERVICE_KEY=your-internal-service-key

# Feature Flags
ENABLE_NEW_PRODUCT_UI=false
NUXT_PUBLIC_ENABLE_MIDTRANS_SANDBOX=false

# Midtrans Configuration
NUXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NUXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
MIDTRANS_SERVER_KEY=
MIDTRANS_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

# E2E Test Credentials (local only, jangan commit nilai asli)
# Default: akun seed lokal (lihat supabase/seed.sql). Untuk CI/cloud,
# isi via env atau GitHub Secrets dengan akun yang sudah ada di Supabase Auth.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
